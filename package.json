{
  "name": "@ldb/meta-updater",
  "version": "0.0.9",
  "description": "Add missing metadata to tickets",
  "main": "index.js",
  "scripts": {
    "repl": "node --experimental-specifier-resolution=node --interactive"
  },
  "repository": {
    "type": "git",
    "url": "https://git3.nexdev.net/l1/database/db-packages/meta-updater.git"
  },
  "author": {
    "name": "Billy Bùi",
    "email": "billy.bui@luminet.vn"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ldb/db-common": "0.0.14",
    "mongodb": "4.9.0"
  },
  "devDependencies": {
    "eslint": "^8.22.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": "airbnb-base",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "array-bracket-spacing": "off",
      "class-methods-use-this": "off",
      "comma-spacing": "off",
      "default-param-last": "off",
      "import/no-named-as-default": "off",
      "import/no-named-as-default-member": "off",
      "key-spacing": "off",
      "max-len": "off",
      "no-extra-semi": "off",
      "no-labels": "off",
      "no-multi-spaces": "off",
      "no-underscore-dangle": "off",
      "object-curly-newline": "off",
      "object-property-newline": "off",
      "quotes": "off"
    }
  }
}
